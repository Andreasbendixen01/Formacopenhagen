{%- comment -%}
  FORMA — PASSPORT
{%- endcomment -%}

<section
  class="forma-dashboard-section forma-passport"
  data-forma-passport
>
  <div class="forma-dashboard-section__header">
    <div class="forma-dashboard-section__heading">
      <p class="forma-dashboard-section__eyebrow">
        Your identity
      </p>

      <h2 class="forma-dashboard-section__title">
        Forma Passport
      </h2>

      <p class="forma-dashboard-section__description">
        Your membership identity inside Forma, shaped by the brands,
        places and experiences you discover.
      </p>
    </div>
  </div>

  <div class="forma-passport__layout">

    <article class="forma-passport__card">

      <div class="forma-passport__card-top">
        <p class="forma-passport__mark">
          FORMA
        </p>

        <p class="forma-passport__type">
          Passport
        </p>
      </div>

      <div class="forma-passport__identity">

        <p class="forma-passport__label">
          Member
        </p>

        <h3
          class="forma-passport__name"
          data-forma-passport-name
        >
          {{ customer.first_name | default: customer.name | default: 'Forma Member' }}
        </h3>

        <p
          class="forma-passport__city"
          data-forma-passport-city
        >
          Copenhagen
        </p>

      </div>

      <div class="forma-passport__card-bottom">

        <div class="forma-passport__meta">
          <span class="forma-passport__meta-label">
            Member since
          </span>

          <span class="forma-passport__meta-value">
            {{ 'now' | date: '%Y' }}
          </span>
        </div>

        <div class="forma-passport__meta">
          <span class="forma-passport__meta-label">
            Status
          </span>

          <span
            class="forma-passport__meta-value"
            data-forma-passport-status
          >
            Explorer
          </span>
        </div>

        <div class="forma-passport__serial">
          <span>
            FORMA —
          </span>

          <span data-forma-passport-id>
            {{ customer.id | default: '000000' }}
          </span>
        </div>

      </div>

    </article>

    <div class="forma-passport__details">

      <div class="forma-passport__details-header">

        <p class="forma-passport__details-eyebrow">
          Your Forma Passport
        </p>

        <div class="forma-passport__status-group">

          <p
            class="forma-passport__status"
            data-forma-passport-status
          >
            Explorer
          </p>

          <p class="forma-passport__member-since">
            Member since {{ 'now' | date: '%Y' }}
          </p>

        </div>

      </div>

      <div class="forma-passport__metrics">

        <article class="forma-passport__metric">
          <p class="forma-passport__metric-label">
            Saved products
          </p>

          <p
            class="forma-passport__metric-value"
            data-forma-passport-saved
          >
            0
          </p>
        </article>

        <article class="forma-passport__metric">
          <p class="forma-passport__metric-label">
            Following brands
          </p>

          <p
            class="forma-passport__metric-value"
            data-forma-passport-brands
          >
            0
          </p>
        </article>

        <article class="forma-passport__metric">
          <p class="forma-passport__metric-label">
            Cities
          </p>

          <p
            class="forma-passport__metric-value"
            data-forma-passport-cities
          >
            0
          </p>
        </article>

        <article
          class="
            forma-passport__metric
            forma-passport__metric--benefits
          "
        >
          <p class="forma-passport__metric-label">
            Member benefits
          </p>

          <p class="forma-passport__metric-text">
            Coming soon
          </p>
        </article>

      </div>

      <div class="forma-passport__carry">

        <button
          class="forma-passport__wallet-button"
          type="button"
          aria-expanded="false"
          aria-controls="FormaPassportCarry"
          data-forma-passport-carry-toggle
        >
          <span>
            Carry your Passport
          </span>

          <span aria-hidden="true">
            →
          </span>
        </button>

        <p class="forma-passport__wallet-note">
          Keep your membership with you wherever you go.
        </p>

      </div>

    </div>

  </div>

  <div
    id="FormaPassportCarry"
    class="forma-passport-carry"
    data-forma-passport-carry
    hidden
  >
    <button
      class="forma-passport-carry__backdrop"
      type="button"
      aria-label="Close Passport options"
      data-forma-passport-carry-close
    ></button>

    <div
      class="forma-passport-carry__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="FormaPassportCarryTitle"
    >
      <div class="forma-passport-carry__header">

        <div>
          <p class="forma-passport-carry__eyebrow">
            Your membership, wherever you go
          </p>

          <h3
            id="FormaPassportCarryTitle"
            class="forma-passport-carry__title"
          >
            Carry your Passport
          </h3>
        </div>

        <button
          class="forma-passport-carry__close"
          type="button"
          aria-label="Close"
          data-forma-passport-carry-close
        >
          ×
        </button>

      </div>

      <div class="forma-passport-carry__options">

        <button
          class="forma-passport-carry__option"
          type="button"
          disabled
          aria-disabled="true"
        >
          <span>
            Apple Wallet
          </span>

          <span>
            Coming soon
          </span>
        </button>

        <button
          class="forma-passport-carry__option"
          type="button"
          disabled
          aria-disabled="true"
        >
          <span>
            Google Wallet
          </span>

          <span>
            Coming soon
          </span>
        </button>

      </div>

      <div class="forma-passport-carry__identity">

        <div>
          <span class="forma-passport-carry__identity-label">
            Passport holder
          </span>

          <strong data-forma-passport-carry-name>
            Forma Member
          </strong>
        </div>

        <div>
          <span class="forma-passport-carry__identity-label">
            Passport ID
          </span>

          <strong data-forma-passport-carry-id>
            FORMA — 000000
          </strong>
        </div>

      </div>

      <p class="forma-passport-carry__note">
        Your Forma Passport will soon be available directly in Apple Wallet
        and Google Wallet.
      </p>

    </div>
  </div>

</section>