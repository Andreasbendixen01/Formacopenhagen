{%- comment -%}
  ==========================================================
  FORMA — MEMBER SHELL
  Desktop: vertical editorial navigation
  Mobile: horizontal navigation
  ==========================================================
{%- endcomment -%}

{%- assign forma_path = request.path -%}

<aside
  class="forma-shell"
  data-forma-shell
>
  <div class="forma-shell__inner">

    <a
      href="/pages/your-forma"
      class="forma-shell__identity"
      data-forma-page-link
      data-forma-direction="back"
    >
      Your Forma
    </a>

    <nav
  class="forma-shell__navigation"
  data-forma-member-navigation
>

  <a
    href="?forma=home"
    class="forma-shell__link"
    data-forma-route="home"
    data-forma-nav-item="home"
  >
    <span>Home</span>
    <span class="forma-shell__arrow">→</span>
  </a>


  <a
    href="?forma=for-you"
    class="forma-shell__link"
    data-forma-route="for-you"
    data-forma-nav-item="for-you"
  >
    <span>For You</span>
    <span class="forma-shell__arrow">→</span>
  </a>


  <a
    href="?forma=saved"
    class="forma-shell__link"
    data-forma-route="saved"
    data-forma-nav-item="saved"
  >
    <span>Saved</span>
    <span class="forma-shell__arrow">→</span>
  </a>


  <a
    href="?forma=collections"
    class="forma-shell__link"
    data-forma-route="collections"
    data-forma-nav-item="collections"
  >
    <span>Collections</span>
    <span class="forma-shell__arrow">→</span>
  </a>


  <a
    href="?forma=passport"
    class="forma-shell__link"
    data-forma-route="passport"
    data-forma-nav-item="passport"
  >
    <span>Passport</span>
    <span class="forma-shell__arrow">→</span>
  </a>


  <a
    href="?forma=activity"
    class="forma-shell__link"
    data-forma-route="activity"
    data-forma-nav-item="activity"
  >
    <span>Activity</span>
    <span class="forma-shell__arrow">→</span>
  </a>

</nav>

    <div class="forma-shell__secondary">

      <a
        href="/pages/your-membership"
        class="forma-shell__membership"
      >
        <span>Membership</span>
        <span aria-hidden="true">↗</span>
      </a>

    </div>

  </div>
</aside>