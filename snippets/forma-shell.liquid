{%- comment -%}
  ==========================================================
  FORMA — MEMBER SHELL
  Desktop: vertical editorial navigation
  Mobile: horizontal navigation
  ==========================================================
{%- endcomment -%}

{%- assign forma_path = request.path -%}

<aside
  class="forma-shell"
  data-forma-shell
>
  <div class="forma-shell__inner">

    <a
      href="/pages/your-forma"
      class="forma-shell__identity"
      data-forma-page-link
      data-forma-direction="back"
    >
      Your Forma
    </a>

    <nav
      class="forma-shell__navigation"
      aria-label="Your Forma navigation"
    >

      <a
        href="/pages/your-forma"
        class="forma-shell__link{% if forma_path == '/pages/your-forma' %} is-active{% endif %}"
        data-forma-page-link
        data-forma-direction="back"
      >
        <span>Home</span>
        <span class="forma-shell__arrow" aria-hidden="true">→</span>
      </a>

      <a
        href="/pages/your-forma-for-you"
        class="forma-shell__link{% if forma_path == '/pages/your-forma-for-you' %} is-active{% endif %}"
        data-forma-page-link
      >
        <span>For You</span>
        <span class="forma-shell__arrow" aria-hidden="true">→</span>
      </a>

      <a
        href="/pages/your-forma-saved"
        class="forma-shell__link{% if forma_path == '/pages/your-forma-saved' %} is-active{% endif %}"
        data-forma-page-link
      >
        <span>Saved</span>
        <span class="forma-shell__arrow" aria-hidden="true">→</span>
      </a>

      <a
        href="/pages/your-forma-collections"
        class="forma-shell__link{% if forma_path == '/pages/your-forma-collections' %} is-active{% endif %}"
        data-forma-page-link
      >
        <span>Collections</span>
        <span class="forma-shell__arrow" aria-hidden="true">→</span>
      </a>

      <a
        href="/pages/your-forma-passport"
        class="forma-shell__link{% if forma_path == '/pages/your-forma-passport' %} is-active{% endif %}"
        data-forma-page-link
      >
        <span>Passport</span>
        <span class="forma-shell__arrow" aria-hidden="true">→</span>
      </a>

    </nav>

    <div class="forma-shell__secondary">

      <a
        href="/pages/your-membership"
        class="forma-shell__membership"
      >
        <span>Membership</span>
        <span aria-hidden="true">↗</span>
      </a>

    </div>

  </div>
</aside>