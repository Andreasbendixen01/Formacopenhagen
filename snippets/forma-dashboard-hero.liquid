<header
  class="forma-dashboard__hero"
  data-forma-dashboard-hero
>
  <div class="forma-dashboard__hero-main">
    <p
      class="forma-dashboard__eyebrow"
      data-forma-hero-eyebrow
    >
      Your Forma
    </p>

    <h1 class="forma-dashboard__title">
  <span data-forma-hero-greeting>
    Welcome back
  </span><span data-forma-profile-name></span>.
</h1>

<p
  class="forma-dashboard__hero-message"
  data-forma-hero-message
>
  Your personal world of design, fashion and places.
</p>

<nav
  class="forma-dashboard__quick-actions"
  aria-label="Your Forma shortcuts"
  data-forma-quick-actions
>
  <button
    class="forma-dashboard__quick-action"
    type="button"
    data-forma-navigate="passport"
  >
    <span>Passport</span>
    <span aria-hidden="true">→</span>
  </button>

  <button
    class="forma-dashboard__quick-action"
    type="button"
    data-forma-navigate="benefits"
  >
    <span>Benefits</span>
    <span aria-hidden="true">→</span>
  </button>

  <button
    class="forma-dashboard__quick-action"
    type="button"
    data-forma-navigate="following"
  >
    <span>Following</span>
    <span aria-hidden="true">→</span>
  </button>

  <button
    class="forma-dashboard__quick-action"
    type="button"
    data-forma-navigate="collections"
  >
    <span>Wish Collections</span>
    <span aria-hidden="true">→</span>
  </button>

  <button
    class="forma-dashboard__quick-action"
    type="button"
    data-forma-navigate="discover"
  >
    <span>Discover</span>
    <span aria-hidden="true">→</span>
  </button>

  <a
    class="forma-dashboard__quick-action"
    href="/pages/your-membership"
  >
    <span>Membership</span>
    <span aria-hidden="true">→</span>
  </a>
</nav>
  </div>

  <div class="forma-dashboard__hero-footer">
    <p
      class="forma-dashboard__hero-context"
      data-forma-hero-context
    >
      Curated by your journey.
    </p>

    <button
      type="button"
      class="forma-dashboard__edit-profile"
      data-forma-edit-profile
    >
      <span>Edit profile</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</header>