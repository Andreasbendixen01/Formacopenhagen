{%- layout none -%}

{%- paginate collection.products by 50 -%}
  {
    "collection": {
      "id": {{ collection.id | json }},
      "handle": {{ collection.handle | json }},
      "title": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | json }},
      "url": {{ collection.url | json }},
      "products_count": {{ collection.products_count | json }}
    },
    "products": [
      {%- for product in collection.products -%}
        {
          "id": {{ product.id | json }},
          "handle": {{ product.handle | json }},
          "title": {{ product.title | json }},
          "vendor": {{ product.vendor | json }},
          "product_type": {{ product.type | json }},
          "tags": {{ product.tags | json }},
          "url": {{ product.url | json }},
          "price": {{ product.price | json }},
          "price_min": {{ product.price_min | json }},
          "price_max": {{ product.price_max | json }},
          "price_varies": {{ product.price_varies | json }},
          "compare_at_price": {{ product.compare_at_price | json }},
          "available": {{ product.available | json }},
          "created_at": {{ product.created_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
          "published_at": {{ product.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
          "featured_image":
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 1200 | json }}
            {%- else -%}
              null
            {%- endif -%},
          "images": [
            {%- for image in product.images limit: 5 -%}
              {{ image | image_url: width: 1200 | json }}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "variants": [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "sku": {{ variant.sku | json }},
                "price": {{ variant.price | json }},
                "compare_at_price": {{ variant.compare_at_price | json }},
                "available": {{ variant.available | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }}
              }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "pagination": {
      "current_page": {{ paginate.current_page | json }},
      "pages": {{ paginate.pages | json }},
      "page_size": {{ paginate.page_size | json }},
      "items": {{ paginate.items | json }},
      "has_previous": {{ paginate.previous.is_link | default: false | json }},
      "has_next": {{ paginate.next.is_link | default: false | json }},
      "previous_page":
        {%- if paginate.previous -%}
          {{ paginate.current_page | minus: 1 | json }}
        {%- else -%}
          null
        {%- endif -%},
      "next_page":
        {%- if paginate.next -%}
          {{ paginate.current_page | plus: 1 | json }}
        {%- else -%}
          null
        {%- endif -%}
    }
  }
{%- endpaginate -%}