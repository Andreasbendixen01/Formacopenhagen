{%- comment -%}
  ==========================================================
  FORMA — ACCOUNT GATEWAY
  Minimal entry point for sign in and membership creation
  ==========================================================
{%- endcomment -%}

{{ 'forma-account-gateway.css' | asset_url | stylesheet_tag }}

{%- if customer -%}

  <script>
    window.location.replace('/pages/your-forma');
  </script>

{%- else -%}

  <section
    class="forma-account-gateway"
    data-forma-account-gateway
  >
    <div class="forma-account-gateway__container">

      <p class="forma-account-gateway__eyebrow">
        Your Forma
      </p>

      <h1 class="forma-account-gateway__title">
        Welcome.
      </h1>

      <div class="forma-account-gateway__statement">
        <p>Your Passport.</p>
        <p>Your Collections.</p>
        <p>Your world.</p>
      </div>

      <nav
        class="forma-account-gateway__actions"
        aria-label="Account options"
      >

        <a
          href="{{ routes.account_login_url }}"
          class="forma-account-gateway__action"
        >
          <span>
            Continue to sign in
          </span>

          <span aria-hidden="true">
            →
          </span>
        </a>

        <a
          href="{{ routes.account_register_url }}"
          class="
            forma-account-gateway__action
            forma-account-gateway__action--membership
          "
        >
          <span>
            Create your membership
          </span>

          <span aria-hidden="true">
            →
          </span>
        </a>

      </nav>

      <p class="forma-account-gateway__note">
        One membership. Your entire Forma.
      </p>

    </div>
  </section>

{%- endif -%}

{% schema %}
{
  "name": "Forma account gateway",
  "settings": [],
  "presets": [
    {
      "name": "Forma account gateway"
    }
  ]
}
{% endschema %}