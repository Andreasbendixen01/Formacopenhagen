{%- comment -%}
  ==========================================================
  FORMA — ACCOUNT GATEWAY
  ==========================================================
{%- endcomment -%}

{{ 'forma-account-gateway.css' | asset_url | stylesheet_tag }}

{%- if customer -%}

  <script>
    window.location.replace('/pages/your-forma');
  </script>

{%- else -%}

  <section
    class="forma-account-gateway"
    data-forma-account-gateway
  >
    <div class="forma-account-gateway__container">

      <p
        class="
          forma-account-gateway__eyebrow
          forma-account-gateway__reveal
        "
      >
        Your Forma
      </p>

      <h1
        class="
          forma-account-gateway__title
          forma-account-gateway__reveal
        "
        data-forma-account-greeting
      >
        Welcome.
      </h1>

      <div class="forma-account-gateway__statement">

        <p
          class="
            forma-account-gateway__statement-line
            forma-account-gateway__statement-line--1
          "
        >
          Your Passport.
        </p>

        <p
          class="
            forma-account-gateway__statement-line
            forma-account-gateway__statement-line--2
          "
        >
          Your Collections.
        </p>

        <p
          class="
            forma-account-gateway__statement-line
            forma-account-gateway__statement-line--3
          "
        >
          Your world.
        </p>

      </div>

      <nav
        class="
          forma-account-gateway__actions
          forma-account-gateway__reveal
        "
        aria-label="Account options"
      >

        {%- if shop.customer_accounts_enabled -%}

        <button
        type="button"
        class="forma-account-gateway__action"
        data-forma-login-open
        aria-haspopup="dialog"
        aria-controls="FormaLoginModal"
        >
        <span class="forma-account-gateway__action-label">
            Sign in
        </span>

        <span
            class="forma-account-gateway__action-arrow"
            aria-hidden="true"
        >
            →
        </span>
        </button>

        {%- endif -%}

        <a
          href="{{ routes.account_register_url }}"
          class="
            forma-account-gateway__action
            forma-account-gateway__action--membership
          "
        >
          <span class="forma-account-gateway__action-label">
            Create membership
          </span>

          <span
            class="forma-account-gateway__action-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>

      </nav>

      <p
        class="
          forma-account-gateway__note
          forma-account-gateway__reveal
        "
      >
        One membership. Your entire Forma.
      </p>

    </div>
  </section>

  <div
  id="FormaLoginModal"
  class="forma-login-modal"
  data-forma-login-modal
  aria-hidden="true"
  hidden
>
  <button
    type="button"
    class="forma-login-modal__backdrop"
    data-forma-login-close
    aria-label="Close sign in"
  ></button>

  <section
    class="forma-login-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="FormaLoginTitle"
  >
    <header class="forma-login-modal__header">
      <p class="forma-login-modal__eyebrow">
        Your Forma
      </p>

      <button
        type="button"
        class="forma-login-modal__close"
        data-forma-login-close
        aria-label="Close"
      >
        ×
      </button>
    </header>

    <div class="forma-login-modal__content">
      <h2
        id="FormaLoginTitle"
        class="forma-login-modal__title"
      >
        Welcome back.
      </h2>

      <p class="forma-login-modal__description">
        Continue securely to access your personal Forma.
      </p>

      <a
        href="/customer_authentication/login?return_to={{ '/pages/your-forma' | url_encode }}"
        class="forma-login-modal__continue"
      >
        <span>Continue to sign in</span>
        <span aria-hidden="true">→</span>
      </a>

      <div class="forma-login-modal__membership">
        <span>New to Forma?</span>

        <a href="/pages/your-forma?create-membership=1">
  Create membership →
</a>
      </div>
    </div>

    <footer class="forma-login-modal__footer">
      <span>Secure authentication by Shopify</span>
    </footer>
  </section>
</div>



  <script>
    (() => {
      const gateway = document.querySelector(
        '[data-forma-account-gateway]'
      );

      if (!gateway) return;

      const greeting = gateway.querySelector(
        '[data-forma-account-greeting]'
      );

      if (greeting) {
        const hour = new Date().getHours();

        let message = 'Welcome.';

        if (hour >= 5 && hour < 12) {
          message = 'Good morning.';
        } else if (hour >= 12 && hour < 18) {
          message = 'Good afternoon.';
        } else if (hour >= 18) {
          message = 'Good evening.';
        }

        greeting.textContent = message;
      }

      requestAnimationFrame(() => {
        gateway.classList.add('is-ready');
      });
    })();
  </script>

{%- endif -%}

{{ 'forma-account-gateway.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Forma account gateway",
  "settings": [],
  "presets": [
    {
      "name": "Forma account gateway"
    }
  ]
}
{% endschema %}