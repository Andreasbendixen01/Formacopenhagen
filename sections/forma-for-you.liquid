{{ 'forma-dashboard.css' | asset_url | stylesheet_tag }}

<section
  class="forma-dashboard"
  data-forma-dashboard
  data-forma-member-app
>

  <main class="forma-dashboard__content">

    <div class="forma-dashboard__container">

      <section
        class="forma-member-view"
        data-forma-view="for-you"
      >

        <header class="forma-member-page-header">

          <p class="forma-dashboard-section__eyebrow">
            For You
          </p>

          <h1 class="forma-member-page-header__title">
            Made for you.
          </h1>

          <p class="forma-member-page-header__description">
            A personal edit shaped by what you follow,
            save, explore and discover.
          </p>

        </header>


        <!-- ==================================================
             DISCOVER AGAIN
             ================================================== -->

        <section
          class="forma-dashboard-section forma-discover-again"
          data-forma-discover-again
          hidden
        >

          <div class="forma-dashboard-section__header">

            <div class="forma-dashboard-section__heading">

              <p class="forma-dashboard-section__eyebrow">
                Worth another look
              </p>

              <h2 class="forma-dashboard-section__title">
                Discover Again
              </h2>

              <p class="forma-dashboard-section__description">
                Products from your journey that deserve to be rediscovered.
              </p>

            </div>

          </div>


          <div
            class="forma-discover-again__layout"
            data-forma-discover-again-content
          >

            <article
              class="forma-discover-again__featured"
              data-forma-discover-again-featured
            ></article>

            <div
              class="forma-discover-again__secondary"
              data-forma-discover-again-secondary
            ></div>

          </div>

        </section>


        <!-- ==================================================
             TODAY'S EDIT
             ================================================== -->

        <section
          class="forma-dashboard-section forma-daily-edit"
          data-forma-daily-edit
          data-forma-section="daily-edit"
          hidden
        >

          <div class="forma-dashboard-section__header">

            <div class="forma-dashboard-section__heading">

              <p class="forma-dashboard-section__eyebrow">
                Curated today
              </p>

              <h2 class="forma-dashboard-section__title">
                Today’s Edit
              </h2>

              <p class="forma-dashboard-section__description">
                A daily selection shaped by your taste,
                activity and the brands you follow.
              </p>

            </div>

            <p
              class="forma-daily-edit__date"
              data-forma-daily-edit-date
            ></p>

          </div>


          <div
            class="forma-daily-edit__layout"
            data-forma-daily-edit-grid
          ></div>

        </section>


        <!-- ==================================================
             SINCE YOUR LAST VISIT
             ================================================== -->

        <section
          class="forma-dashboard-section forma-new-arrivals"
          data-forma-new-arrivals
          data-forma-section="new-arrivals"
          hidden
        >

          <div class="forma-dashboard-section__header">

            <div class="forma-dashboard-section__heading">

              <p class="forma-dashboard-section__eyebrow">
                Your brand updates
              </p>

              <h2 class="forma-dashboard-section__title">
                Since Your Last Visit
              </h2>

              <p class="forma-dashboard-section__description">
                New arrivals from the brands you follow,
                gathered in one place.
              </p>

            </div>

            <p
              class="forma-new-arrivals__total"
              data-forma-new-arrivals-total
            ></p>

          </div>


          <div
            class="forma-new-arrivals__skeleton"
            data-forma-new-arrivals-skeleton
            aria-hidden="true"
          >

            {% for index in (1..3) %}

              <div class="forma-new-arrivals__skeleton-row">

                <span class="forma-new-arrivals__skeleton-index"></span>

                <span class="forma-new-arrivals__skeleton-name"></span>

                <span class="forma-new-arrivals__skeleton-count"></span>

                <span class="forma-new-arrivals__skeleton-icon"></span>

              </div>

            {% endfor %}

          </div>


          <div
            class="forma-new-arrivals__list"
            data-forma-new-arrivals-list
          ></div>


          <div
            class="forma-new-arrivals__empty"
            data-forma-new-arrivals-empty
            hidden
          >

            <p class="forma-new-arrivals__empty-index">
              You’re up to date
            </p>

            <h3 class="forma-new-arrivals__empty-title">
              Nothing new since your last visit.
            </h3>

            <p class="forma-new-arrivals__empty-text">
              We’ll keep an eye on the brands you follow
              and collect their newest arrivals here.
            </p>

            <a
              href="/pages/brands"
              class="forma-new-arrivals__empty-link"
            >
              <span>
                Discover more brands
              </span>

              <span aria-hidden="true">
                →
              </span>
            </a>

          </div>

        </section>


        <!-- ==================================================
             CONTINUE EXPLORING
             ================================================== -->

        <section
          class="forma-dashboard-section forma-continue"
          data-forma-continue
        >

          <div class="forma-dashboard-section__header">

            <div class="forma-dashboard-section__heading">

              <p class="forma-dashboard-section__eyebrow">
                Pick up where you left off
              </p>

              <h2 class="forma-dashboard-section__title">
                Continue Exploring
              </h2>

              <p class="forma-dashboard-section__description">
                A personal selection of products worth another look.
              </p>

            </div>

            <a
              href="/collections/all"
              class="forma-dashboard-section__link"
            >
              <span>
                Explore products
              </span>

              <span aria-hidden="true">
                →
              </span>
            </a>

          </div>


          <div
            class="forma-continue__content"
            data-forma-continue-content
            hidden
          >

            <article
              class="forma-continue__featured"
              data-forma-continue-featured
            ></article>

            <div
              class="forma-continue__secondary"
              data-forma-continue-secondary
            ></div>

          </div>


          <div
            class="forma-recently-viewed__empty"
            data-forma-continue-empty
            hidden
          >

            <p class="forma-recently-viewed__empty-index">
              Continue
            </p>

            <h3 class="forma-recently-viewed__empty-title">
              Your next discovery starts here.
            </h3>

            <p class="forma-recently-viewed__empty-text">
              Explore Forma and the products worth returning to
              will appear here.
            </p>

            <a
              href="/collections/all"
              class="forma-recently-viewed__empty-link"
            >
              <span>
                Start exploring
              </span>

              <span aria-hidden="true">
                →
              </span>
            </a>

          </div>

        </section>


        <!-- ==================================================
             RECOMMENDED FOR YOU
             ================================================== -->

        <section
          class="forma-dashboard-section forma-recommended"
          data-forma-recommended
          hidden
        >

          <div class="forma-dashboard-section__header">

            <div class="forma-dashboard-section__heading">

              <p class="forma-dashboard-section__eyebrow">
                Chosen around you
              </p>

              <h2 class="forma-dashboard-section__title">
                Recommended for You
              </h2>

              <p class="forma-dashboard-section__description">
                A personal edit shaped by the brands,
                products and details you explore.
              </p>

            </div>

            <button
              class="forma-recommended__refresh"
              type="button"
              data-forma-recommended-refresh
            >
              Refresh selection
            </button>

          </div>


          <div
            class="forma-recommended__grid"
            data-forma-recommended-grid
          ></div>

        </section>

      </section>

    </div>

  </main>

</section>


<script
  src="{{ 'forma-core.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-signals.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-entities.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-persona.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-products.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-engine.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-recommendation-engine.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-recommendations.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-daily-edit-service.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-daily-edit.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-discover-again.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-new-arrivals-engine.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-continue-exploring.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-followed-brands.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-recently-viewed.js' | asset_url }}"
  defer
></script>

<script
  src="{{ 'forma-dashboard.js' | asset_url }}"
  defer
></script>