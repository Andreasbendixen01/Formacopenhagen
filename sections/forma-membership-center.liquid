{{ 'forma-membership-center.css' | asset_url | stylesheet_tag }}

<section
  class="forma-membership-center"
  data-forma-membership-center
>
  <div class="forma-membership-center__container">

    <header class="forma-membership-center__hero">

      <div class="forma-membership-center__hero-copy">

        <p class="forma-membership-center__eyebrow">
          Your Forma
        </p>

        <h1 class="forma-membership-center__title">
          Your Membership
        </h1>

        <p class="forma-membership-center__description">
          Everything connected to your identity, preferences and Forma Passport.
        </p>

      </div>

      <a
        href="/pages/your-forma"
        class="forma-membership-center__back"
      >
        <span aria-hidden="true">←</span>
        <span>Back to Your Forma</span>
      </a>

    </header>

    <div class="forma-membership-center__layout">

      <nav
        class="forma-membership-center__navigation"
        aria-label="Membership settings"
      >

        <button
          class="forma-membership-center__nav-item is-active"
          type="button"
          data-membership-tab="profile"
          aria-selected="true"
        >
          <span>01</span>
          <span>Profile</span>
        </button>

        <button
          class="forma-membership-center__nav-item"
          type="button"
          data-membership-tab="preferences"
          aria-selected="false"
        >
          <span>02</span>
          <span>Preferences</span>
        </button>

        <button
          class="forma-membership-center__nav-item"
          type="button"
          data-membership-tab="sizes"
          aria-selected="false"
        >
          <span>03</span>
          <span>Sizes</span>
        </button>

        <button
          class="forma-membership-center__nav-item"
          type="button"
          data-membership-tab="passport"
          aria-selected="false"
        >
          <span>04</span>
          <span>Passport</span>
        </button>

        <button
          class="forma-membership-center__nav-item"
          type="button"
          data-membership-tab="notifications"
          aria-selected="false"
        >
          <span>05</span>
          <span>Notifications</span>
        </button>

        <button
          class="forma-membership-center__nav-item"
          type="button"
          data-membership-tab="privacy"
          aria-selected="false"
        >
          <span>06</span>
          <span>Privacy</span>
        </button>

      </nav>

      <main class="forma-membership-center__content">

        <section
        class="forma-membership-panel is-active"
        data-membership-panel="profile"
        >
        <div class="forma-membership-panel__header">
            <p class="forma-membership-panel__eyebrow">
            Personal information
            </p>

            <h2 class="forma-membership-panel__title">
            Profile
            </h2>

            <p class="forma-membership-panel__description">
            The personal details connected to your Forma membership.
            </p>
        </div>

        <form
            class="forma-membership-profile"
            data-membership-profile-form
            novalidate
        >
            <div class="forma-membership-profile__grid">

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipFirstName"
                >
                First name
                </label>

                <input
                id="FormaMembershipFirstName"
                class="forma-membership-field__input"
                type="text"
                name="firstName"
                autocomplete="given-name"
                data-membership-profile-field
                >
            </div>

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipLastName"
                >
                Last name
                </label>

                <input
                id="FormaMembershipLastName"
                class="forma-membership-field__input"
                type="text"
                name="lastName"
                autocomplete="family-name"
                data-membership-profile-field
                >
            </div>

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipEmail"
                >
                Email
                </label>

                <input
                id="FormaMembershipEmail"
                class="
                    forma-membership-field__input
                    forma-membership-field__input--readonly
                "
                type="email"
                value="{{ customer.email | escape }}"
                autocomplete="email"
                readonly
                aria-readonly="true"
                >

                <p class="forma-membership-field__note">
                Your email is managed through your Shopify customer account.
                </p>
            </div>

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipCity"
                >
                Home city
                </label>

                <input
                id="FormaMembershipCity"
                class="forma-membership-field__input"
                type="text"
                name="city"
                autocomplete="address-level2"
                data-membership-profile-field
                >
            </div>

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipBirthday"
                >
                Birthday
                </label>

                <input
                id="FormaMembershipBirthday"
                class="forma-membership-field__input"
                type="date"
                name="birthday"
                autocomplete="bday"
                data-membership-profile-field
                >

                <p class="forma-membership-field__note">
                Used for future member moments and personal experiences.
                </p>
            </div>

            <div class="forma-membership-field">
                <label
                class="forma-membership-field__label"
                for="FormaMembershipPhone"
                >
                Phone
                </label>

                <input
                id="FormaMembershipPhone"
                class="forma-membership-field__input"
                type="tel"
                name="phone"
                autocomplete="tel"
                data-membership-profile-field
                >
            </div>

            </div>

            <div class="forma-membership-profile__footer">

            <p
                class="forma-membership-profile__status"
                data-membership-profile-status
                aria-live="polite"
            ></p>

            <button
                class="forma-membership-profile__save"
                type="submit"
                data-membership-profile-save
            >
                <span>Save changes</span>
                <span aria-hidden="true">→</span>
            </button>

            </div>
        </form>
        </section>

        <section
        class="forma-membership-panel"
        data-membership-panel="preferences"
        hidden>

  <div class="forma-membership-panel__header">
    <p class="forma-membership-panel__eyebrow">
      Shape your experience
    </p>

    <h2 class="forma-membership-panel__title">
      Preferences
    </h2>

    <p class="forma-membership-panel__description">
      Manage the interests and styles that shape your recommendations,
      personal edits and discoveries across Forma.
    </p>
  </div>

  <form
    class="forma-membership-preferences"
    data-membership-preferences-form
  >
    <fieldset
      class="forma-membership-preference-group"
      data-membership-preference-group="categories"
    >
      <legend class="forma-membership-preference-group__header">
        <span class="forma-membership-preference-group__number">
          01
        </span>

        <span>
          <strong class="forma-membership-preference-group__title">
            Your interests
          </strong>

          <span class="forma-membership-preference-group__description">
            Choose the worlds you would like Forma to bring closer to you.
          </span>
        </span>
      </legend>

      <div class="forma-membership-preference-options">

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="fashion"
          aria-pressed="false"
        >
          Fashion
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="home"
          aria-pressed="false"
        >
          Home
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="design"
          aria-pressed="false"
        >
          Design
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="travel"
          aria-pressed="false"
        >
          Travel
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="hotels"
          aria-pressed="false"
        >
          Hotels
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="restaurants"
          aria-pressed="false"
        >
          Restaurants
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="coffee"
          aria-pressed="false"
        >
          Coffee
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="art"
          aria-pressed="false"
        >
          Art
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="architecture"
          aria-pressed="false"
        >
          Architecture
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="culture"
          aria-pressed="false"
        >
          Culture
        </button>

      </div>
    </fieldset>

    <fieldset
      class="forma-membership-preference-group"
      data-membership-preference-group="styles"
    >
      <legend class="forma-membership-preference-group__header">
        <span class="forma-membership-preference-group__number">
          02
        </span>

        <span>
          <strong class="forma-membership-preference-group__title">
            Your style
          </strong>

          <span class="forma-membership-preference-group__description">
            Select the expressions that feel closest to your personal taste.
          </span>
        </span>
      </legend>

      <div class="forma-membership-preference-options">

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="minimal"
          aria-pressed="false"
        >
          Minimal
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="contemporary"
          aria-pressed="false"
        >
          Contemporary
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="classic"
          aria-pressed="false"
        >
          Classic
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="scandinavian"
          aria-pressed="false"
        >
          Scandinavian
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="streetwear"
          aria-pressed="false"
        >
          Streetwear
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="tailored"
          aria-pressed="false"
        >
          Tailored
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="vintage"
          aria-pressed="false"
        >
          Vintage
        </button>

        <button
          class="forma-membership-preference-option"
          type="button"
          data-membership-preference-value="avant-garde"
          aria-pressed="false"
        >
          Avant-garde
        </button>

      </div>
    </fieldset>

    <div class="forma-membership-preferences__footer">

      <div>
        <p
          class="forma-membership-preferences__status"
          data-membership-preferences-status
          aria-live="polite"
        ></p>

        <p class="forma-membership-preferences__note">
          Your selections help Forma shape recommendations around you.
        </p>
      </div>

      <button
        class="forma-membership-preferences__save"
        type="submit"
        data-membership-preferences-save
      >
        <span>Save preferences</span>
        <span aria-hidden="true">→</span>
      </button>

    </div>
  </form>
</section>

        <section
  class="forma-membership-panel"
  data-membership-panel="sizes"
  hidden
>
  <div class="forma-membership-panel__header">
    <p class="forma-membership-panel__eyebrow">
      Made to fit
    </p>

    <h2 class="forma-membership-panel__title">
      Sizes
    </h2>

    <p class="forma-membership-panel__description">
      Keep your everyday sizes available throughout Forma and make future
      product recommendations more relevant.
    </p>
  </div>

  <form
    class="forma-membership-sizes"
    data-membership-sizes-form
  >
    <div class="forma-membership-sizes__grid">

      <label class="forma-membership-size-card">

        <span class="forma-membership-size-card__number">
          01
        </span>

        <span class="forma-membership-size-card__content">

          <span class="forma-membership-size-card__label">
            Tops
          </span>

          <span class="forma-membership-size-card__description">
            Your preferred size for shirts, knitwear, T-shirts and outerwear.
          </span>

          <span class="forma-membership-size-card__select-wrap">

            <select
              class="forma-membership-size-card__select"
              name="tops"
              data-membership-size-field
            >
              <option value="">
                Select size
              </option>

              <option value="XS">XS</option>
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
              <option value="XXL">XXL</option>
            </select>

            <span aria-hidden="true">
              ↓
            </span>

          </span>

        </span>

      </label>

      <label class="forma-membership-size-card">

        <span class="forma-membership-size-card__number">
          02
        </span>

        <span class="forma-membership-size-card__content">

          <span class="forma-membership-size-card__label">
            Bottoms
          </span>

          <span class="forma-membership-size-card__description">
            Your preferred size for trousers, denim, shorts and skirts.
          </span>

          <span class="forma-membership-size-card__select-wrap">

            <select
              class="forma-membership-size-card__select"
              name="bottoms"
              data-membership-size-field
            >
              <option value="">
                Select size
              </option>

              <option value="XS">XS</option>
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
              <option value="XXL">XXL</option>
            </select>

            <span aria-hidden="true">
              ↓
            </span>

          </span>

        </span>

      </label>

      <label class="forma-membership-size-card">

        <span class="forma-membership-size-card__number">
          03
        </span>

        <span class="forma-membership-size-card__content">

          <span class="forma-membership-size-card__label">
            Shoes
          </span>

          <span class="forma-membership-size-card__description">
            Your usual European shoe size.
          </span>

          <span class="forma-membership-size-card__select-wrap">

            <select
              class="forma-membership-size-card__select"
              name="shoes"
              data-membership-size-field
            >
              <option value="">
                Select size
              </option>

              {% for size in (35..48) %}
                <option value="{{ size }}">
                  EU {{ size }}
                </option>
              {% endfor %}
            </select>

            <span aria-hidden="true">
              ↓
            </span>

          </span>

        </span>

      </label>

    </div>

    <div class="forma-membership-sizes__footer">

      <div>
        <p
          class="forma-membership-sizes__status"
          data-membership-sizes-status
          aria-live="polite"
        ></p>

        <p class="forma-membership-sizes__note">
          You can update your sizes whenever your preferences change.
        </p>
      </div>

      <button
        class="forma-membership-sizes__save"
        type="submit"
        data-membership-sizes-save
      >
        <span>Save sizes</span>
        <span aria-hidden="true">→</span>
      </button>

    </div>
  </form>
</section>

        <section
          class="forma-membership-panel"
          data-membership-panel="passport"
          hidden
        >
          <div class="forma-membership-panel__header">
            <p class="forma-membership-panel__eyebrow">
              Your identity
            </p>

            <h2 class="forma-membership-panel__title">
              Passport
            </h2>

            <p class="forma-membership-panel__description">
              View the identity and status connected to your Forma Passport.
            </p>
          </div>
        </section>

        <section
          class="forma-membership-panel"
          data-membership-panel="notifications"
          hidden
        >
          <div class="forma-membership-panel__header">
            <p class="forma-membership-panel__eyebrow">
              Stay connected
            </p>

            <h2 class="forma-membership-panel__title">
              Notifications
            </h2>

            <p class="forma-membership-panel__description">
              Choose what you would like to hear from Forma about.
            </p>
          </div>
        </section>

        <section
          class="forma-membership-panel"
          data-membership-panel="privacy"
          hidden
        >
          <div class="forma-membership-panel__header">
            <p class="forma-membership-panel__eyebrow">
              Your information
            </p>

            <h2 class="forma-membership-panel__title">
              Privacy
            </h2>

            <p class="forma-membership-panel__description">
              Manage your data, privacy and membership access.
            </p>
          </div>
        </section>

      </main>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Forma Membership Center",
  "settings": [],
  "presets": [
    {
      "name": "Forma Membership Center"
    }
  ]
}
{% endschema %}